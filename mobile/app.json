{
  "expo": {
    "name": "AIDEP",
    "slug": "aidep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aideplogo.png",
    "scheme": "aidep",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a1628",
        "foregroundImage": "./assets/images/aideplogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.aidep.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/aideplogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/aideplogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a1628",
          "dark": {
            "backgroundColor": "#0a1628"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
